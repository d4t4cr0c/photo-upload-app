{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "CLOUDINARY_FOLDER": "app-images",
        "BACKEND_API_URL": "http://localhost:3000"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "CLOUDINARY_FOLDER": "app-images"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "CLOUDINARY_FOLDER": "app-images"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
